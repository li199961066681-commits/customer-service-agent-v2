# ===== 大模型（必填）=====
# 复制本文件为 .env，填写你自己的 DeepSeek Key（不要提交真实 Key）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ===== 检索（可选 BGE-M3；未配置时使用本地词表向量）=====
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ===== 短期记忆 Redis（可选；未启动时降级为进程内 dict）=====
REDIS_URL=redis://localhost:6379/0

# ===== 可观测性 Langfuse（可选；未配置 Key 时降级为本地 Trace 日志）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 业务参数 =====
GROUNDED_THRESHOLD=0.25
MAX_CONTEXT_TURNS=10
